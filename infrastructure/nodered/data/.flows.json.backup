    {
        "id": "0507b96b5c4bda8c",
        "type": "function",
        "z": "c882ef36171e5406",
        "name": "Prepare History Query",
        "func": "const deviceId = flow.get(\"selectedDevice\");\nlet selectedDate = msg.payload;\n\nif (!deviceId) {\n    node.warn(\"HISTORY: Chưa có device được chọn\");\n    return null;\n}\n\nif (!selectedDate) {\n    node.warn(\"HISTORY: Chưa có ngày được chọn\");\n    return null;\n}\n\nif (\n    typeof selectedDate === \"number\" &&\n    isFinite(selectedDate)\n) {\n    const d = new Date(selectedDate);\n\n    if (isNaN(d.getTime())) {\n        node.warn(\n            \"HISTORY: Timestamp không hợp lệ = \" +\n            selectedDate\n        );\n        return null;\n    }\n\n    selectedDate = d.toISOString().slice(0, 10);\n}\n\nelse if (selectedDate instanceof Date) {\n\n    selectedDate = selectedDate\n        .toISOString()\n        .slice(0, 10);\n}\n\nelse {\n\n    selectedDate = String(selectedDate);\n\n    if (selectedDate.includes(\"T\")) {\n        selectedDate = selectedDate.split(\"T\")[0];\n    }\n\n    else if (/^\\d{2}\\/\\d{2}\\/\\d{4}$/.test(selectedDate)) {\n\n        const p = selectedDate.split(\"/\");\n\n        selectedDate =\n            `${p[2]}-${p[1]}-${p[0]}`;\n    }\n}\n\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(selectedDate)) {\n\n    node.warn(\n        \"HISTORY: Ngày không hợp lệ = \" +\n        selectedDate\n    );\n\n    return null;\n}\n\nmsg.topic = `\nSELECT\n    device_id,\n    temperature,\n    ph,\n    turbidity,\n    temp_status,\n    ph_status,\n    tur_status,\n    created_at\nFROM sensor_data_clean\nWHERE device_id = ?\n  AND created_at >= ?\n  AND created_at < DATE_ADD(?, INTERVAL 1 DAY)\nORDER BY created_at ASC\n`;\n\nmsg.payload = [\n    deviceId,\n    selectedDate + \" 00:00:00\",\n    selectedDate + \" 00:00:00\"\n];\n\nnode.warn(\n    \"HISTORY QUERY | DEVICE=\" +\n    deviceId +\n    \" | DATE=\" +\n    selectedDate\n);\n\nnode.warn(\n    \"SQL PARAMS = \" +\n    JSON.stringify(msg.payload)\n);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 540,
        "wires": [
            [
                "9095156fc048778e"
            ]
        ]
    },
