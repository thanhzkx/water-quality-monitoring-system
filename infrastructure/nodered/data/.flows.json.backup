    {
        "id": "9f58ee94dcfb6c61",
        "type": "function",
        "z": "669c09c766e36bb6",
        "name": "Filter NULL",
        "func": "let data = msg.payload;\n\n// Chỉ loại bỏ những dòng hoàn toàn không có dữ liệu sensor\nmsg.payload = data.filter(row => {\n    return !(\n        row.temperature === null &&\n        row.ph === null &&\n        row.turbidity === null\n    );\n});\n\nnode.warn(\n    \"Filter NULL: còn \" +\n    msg.payload.length +\n    \" dòng\"\n);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 320,
        "wires": [
            [
                "acd4484e6459df54"
            ]
        ]
    },
    {
        "id": "acd4484e6459df54",
        "type": "function",
        "z": "669c09c766e36bb6",
        "name": "Deduplication",
        "func": "let data = msg.payload;\n\nlet seen = new Set();\nlet result = [];\n\nfor (let row of data) {\n\n    // Khóa để xác định bản ghi trùng\n    let key =\n        row.device_id + \"|\" +\n        row.created_at + \"|\" +\n        row.temperature + \"|\" +\n        row.ph + \"|\" +\n        row.turbidity;\n\n    if (!seen.has(key)) {\n        seen.add(key);\n        result.push(row);\n    }\n}\n\nmsg.payload = result;\n\nnode.warn(\n    \"Deduplication: còn \" +\n    result.length +\n    \" dòng\"\n);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 420,
        "wires": [
            [
                "6a38ae125b9a959e"
            ]
        ]
    },
    {
        "id": "6a38ae125b9a959e",
        "type": "function",
        "z": "669c09c766e36bb6",
        "name": "Resampling",
        "func": "let data = msg.payload;\n\nconst SAMPLE_TIME = 6000;      // 6 giây\nconst MAX_INTERPOLATE = 2;     // tối đa nội suy 2 mẫu\n\nif (!Array.isArray(data)) {\n    node.error(\"Payload không phải array\");\n    return null;\n}\n\n// Chia dữ liệu theo device_id\nlet groups = {};\n\nfor (const row of data) {\n\n    const deviceId = row.device_id;\n\n    if (!deviceId) {\n        node.warn(\"Dòng không có device_id\");\n        continue;\n    }\n\n    if (!groups[deviceId]) {\n        groups[deviceId] = [];\n    }\n\n    groups[deviceId].push(row);\n}\n\n// Resampling riêng từng device\nlet result = [];\n\nfor (const deviceId of Object.keys(groups)) {\n\n    let deviceData = groups[deviceId];\n\n    // Đảm bảo thứ tự thời gian\n    deviceData.sort((a, b) =>\n        new Date(a.created_at).getTime() -\n        new Date(b.created_at).getTime()\n    );\n\n    for (let i = 0; i < deviceData.length - 1; i++) {\n\n        let current = deviceData[i];\n        let next = deviceData[i + 1];\n\n        result.push(current);\n\n        let t1 = new Date(current.created_at).getTime();\n        let t2 = new Date(next.created_at).getTime();\n\n        let diff = t2 - t1;\n\n        let missing =\n            Math.round(diff / SAMPLE_TIME) - 1;\n\n        // Khoảng trống nhỏ\n        if (\n            missing > 0 &&\n            missing <= MAX_INTERPOLATE\n        ) {\n\n            for (let j = 1; j <= missing; j++) {\n\n                result.push({\n\n                    id: null,\n\n                    device_id: deviceId,\n\n                    temperature: null,\n                    ph: null,\n                    turbidity: null,\n\n                    created_at:\n                        new Date(\n                            t1 + SAMPLE_TIME * j\n                        ).toISOString(),\n\n                    temp_status: \"missing\",\n                    ph_status: \"missing\",\n                    tur_status: \"missing\"\n\n                });\n\n            }\n        }\n\n        // Khoảng trống lớn\n        else if (missing > MAX_INTERPOLATE) {\n\n            node.warn(\n                \"Khoảng trống lớn [\" +\n                deviceId +\n                \"]: \" +\n                current.created_at +\n                \" -> \" +\n                next.created_at\n            );\n\n        }\n    }\n\n    // Thêm dòng cuối của device\n    if (deviceData.length > 0) {\n        result.push(\n            deviceData[deviceData.length - 1]\n        );\n    }\n}\n\n// Sắp xếp lại toàn bộ dữ liệu\nresult.sort((a, b) =>\n    new Date(a.created_at).getTime() -\n    new Date(b.created_at).getTime()\n);\n\nmsg.payload = result;\n\nnode.warn(\n    \"Resampling: \" +\n    data.length +\n    \" -> \" +\n    result.length +\n    \" dòng\"\n);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 500,
        "wires": [
            [
                "75fec0c4658aa41e"
            ]
        ]
    },
    {
        "id": "75fec0c4658aa41e",
        "type": "function",
        "z": "669c09c766e36bb6",
        "name": "Rolling IQR",
        "func": "let data = msg.payload;\n\nconst WINDOW = 23;\n\nif (!Array.isArray(data)) {\n    node.error(\"Payload không phải array\");\n    return null;\n}\n\n// Tính phân vị\nfunction percentile(arr, p) {\n\n    let index = (arr.length - 1) * p;\n\n    let lower = Math.floor(index);\n    let upper = Math.ceil(index);\n\n    if (lower === upper)\n        return arr[lower];\n\n    return arr[lower] +\n        (arr[upper] - arr[lower]) *\n        (index - lower);\n}\n\n// Chia dữ liệu theo device\nlet groups = {};\n\nfor (const row of data) {\n\n    const deviceId = row.device_id;\n\n    if (!deviceId) {\n        node.warn(\"Dòng không có device_id\");\n        continue;\n    }\n\n    if (!groups[deviceId]) {\n        groups[deviceId] = [];\n    }\n\n    groups[deviceId].push(row);\n}\n\n// IQR riêng từng device\nfor (const deviceId of Object.keys(groups)) {\n\n    let deviceData = groups[deviceId];\n\n    function processIQR(column) {\n\n        for (let i = 0; i < deviceData.length; i++) {\n\n            let start = Math.max(\n                0,\n                i - Math.floor(WINDOW / 2)\n            );\n\n            let end = Math.min(\n                deviceData.length,\n                i + Math.floor(WINDOW / 2) + 1\n            );\n\n            let window = deviceData\n                .slice(start, end)\n                .map(x => x[column])\n                .filter(v =>\n                    v !== null &&\n                    v !== undefined &&\n                    !isNaN(v)\n                )\n                .sort((a, b) => a - b);\n\n            if (window.length < 4)\n                continue;\n\n            let Q1 = percentile(window, 0.25);\n            let Q3 = percentile(window, 0.75);\n\n            let IQR = Q3 - Q1;\n\n            let lower = Q1 - 1.5 * IQR;\n            let upper = Q3 + 1.5 * IQR;\n\n            if (\n                deviceData[i][column] !== null &&\n                deviceData[i][column] !== undefined &&\n                (\n                    deviceData[i][column] < lower ||\n                    deviceData[i][column] > upper\n                )\n            ) {\n\n                deviceData[i][column] = null;\n\n            }\n        }\n    }\n\n    processIQR(\"temperature\");\n    processIQR(\"ph\");\n    processIQR(\"turbidity\");\n}\n\n// Gộp dữ liệu lại\nlet result = [];\n\nfor (const deviceId of Object.keys(groups)) {\n\n    result.push(\n        ...groups[deviceId]\n    );\n\n}\n\n// Giữ thứ tự thời gian\nresult.sort((a, b) =>\n    new Date(a.created_at).getTime() -\n    new Date(b.created_at).getTime()\n);\n\nmsg.payload = result;\n\nnode.warn(\n    \"Rolling IQR xong: \" +\n    result.length +\n    \" dòng\"\n);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 580,
        "wires": [
            [
                "9106da8b3eb542bd"
            ]
        ]
    },
    {
        "id": "9106da8b3eb542bd",
        "type": "function",
        "z": "669c09c766e36bb6",
        "name": "Interpolation",
        "func": "let data = msg.payload;\n\nconst MAX_GAP = 2;\n\nif (!Array.isArray(data)) {\n    node.error(\"Payload không phải array\");\n    return null;\n}\n\n// Chia dữ liệu theo device\nlet groups = {};\n\nfor (const row of data) {\n\n    const deviceId = row.device_id;\n\n    if (!deviceId) {\n        node.warn(\"Dòng không có device_id\");\n        continue;\n    }\n\n    if (!groups[deviceId]) {\n        groups[deviceId] = [];\n    }\n\n    groups[deviceId].push(row);\n}\n\n// Nội suy riêng từng device\nfunction interpolate(deviceData, column) {\n\n    let i = 0;\n\n    while (i < deviceData.length) {\n\n        if (\n            deviceData[i][column] !== null &&\n            deviceData[i][column] !== undefined\n        ) {\n            i++;\n            continue;\n        }\n\n        let start = i - 1;\n        let end = i;\n\n        while (\n            end < deviceData.length &&\n            (\n                deviceData[end][column] === null ||\n                deviceData[end][column] === undefined\n            )\n        ) {\n            end++;\n        }\n\n        let gap = end - start - 1;\n\n        if (\n            start >= 0 &&\n            end < deviceData.length &&\n            gap <= MAX_GAP\n        ) {\n\n            let first =\n                Number(deviceData[start][column]);\n\n            let last =\n                Number(deviceData[end][column]);\n\n            let step =\n                (last - first) /\n                (gap + 1);\n\n            for (let k = 1; k <= gap; k++) {\n\n                deviceData[start + k][column] =\n                    Number(\n                        (\n                            first +\n                            step * k\n                        ).toFixed(2)\n                    );\n            }\n        }\n\n        i = end;\n    }\n}\n\nfor (const deviceId of Object.keys(groups)) {\n\n    let deviceData = groups[deviceId];\n\n    // Sắp xếp theo thời gian tăng dần\n    deviceData.sort((a, b) =>\n        new Date(a.created_at).getTime() -\n        new Date(b.created_at).getTime()\n    );\n\n    interpolate(deviceData, \"temperature\");\n    interpolate(deviceData, \"ph\");\n    interpolate(deviceData, \"turbidity\");\n}\n\n// Gộp dữ liệu\nlet result = [];\n\nfor (const deviceId of Object.keys(groups)) {\n\n    result.push(\n        ...groups[deviceId]\n    );\n}\n\n// Sắp xếp lại theo thời gian\nresult.sort((a, b) =>\n    new Date(a.created_at).getTime() -\n    new Date(b.created_at).getTime()\n);\n\nmsg.payload = result;\n\nnode.warn(\n    \"Interpolation xong: \" +\n    result.length +\n    \" dòng\"\n);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 680,
        "wires": [
            [
                "bcf1774e706c9159"
            ]
        ]
    },
    {
        "id": "bcf1774e706c9159",
        "type": "function",
        "z": "669c09c766e36bb6",
        "name": "Clear Clean Table",
        "func": "let cleanData = msg.payload;\n\nmsg.cleanData = cleanData;\n\nmsg.topic = `DELETE FROM sensor_data_clean;`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 970,
        "y": 340,
        "wires": [
            [
                "f54af7d4ea93a2c7"
            ]
        ]
    },
    {
