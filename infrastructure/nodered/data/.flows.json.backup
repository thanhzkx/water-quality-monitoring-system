    {
        "id": "9982d75edda5c1cb",
        "type": "function",
        "z": "c882ef36171e5406",
        "name": "Format History",
        "func": "let rows = msg.payload;\n\nif (!Array.isArray(rows)) {\n    node.error(\"HISTORY: payload không phải array\", msg);\n    return null;\n}\n\nlet temp = [];\nlet ph = [];\nlet tur = [];\n\nrows.forEach(row => {\n\n    let t = new Date(row.created_at);\n\n    if (isNaN(t.getTime())) {\n        return;\n    }\n\n    if (row.temperature != null) {\n\n        let value = Number(row.temperature);\n\n        if (isFinite(value)) {\n            temp.push({\n                x: t.getTime(),\n                y: value\n            });\n        }\n    }\n\n    if (row.ph != null) {\n\n        let value = Number(row.ph);\n\n        if (isFinite(value)) {\n            ph.push({\n                x: t.getTime(),\n                y: value\n            });\n        }\n    }\n\n    if (row.turbidity != null) {\n\n        let value = Number(row.turbidity);\n\n        if (isFinite(value)) {\n            tur.push({\n                x: t.getTime(),\n                y: value\n            });\n        }\n    }\n\n});\n\nnode.warn(\n    \"HISTORY CHART | TEMP=\" + temp.length +\n    \" | PH=\" + ph.length +\n    \" | TUR=\" + tur.length\n);\n\nnode.send([\n    {\n        topic: \"Temperature\",\n        reset: true,\n        payload: []\n    },\n    {\n        topic: \"pH\",\n        reset: true,\n        payload: []\n    },\n    {\n        topic: \"Turbidity\",\n        reset: true,\n        payload: []\n    }\n]);\n\nif (\n    temp.length === 0 &&\n    ph.length === 0 &&\n    tur.length === 0\n) {\n    node.warn(\"HISTORY: Không có dữ liệu để vẽ\");\n    return null;\n}\n\nreturn [\n    {\n        topic: \"Temperature\",\n        payload: [\n            {\n                series: [\"Temperature\"],\n                data: [temp]\n            }\n        ]\n    },\n    {\n        topic: \"pH\",\n        payload: [\n            {\n                series: [\"pH\"],\n                data: [ph]\n            }\n        ]\n    },\n    {\n        topic: \"Turbidity\",\n        payload: [\n            {\n                series: [\"Turbidity\"],\n                data: [tur]\n            }\n        ]\n    }\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 820,
        "y": 540,
        "wires": [
            [
                "e55b5c6410ca6a99"
            ],
            [
                "60932f45a6c8ae3e"
            ],
            [
                "b3b085060e891065"
            ]
        ]
    },
