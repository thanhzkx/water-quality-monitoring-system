    {
        "id": "60a0c7edee256877",
        "type": "function",
        "z": "d202adfd03874078",
        "name": "Normalize MQTT Data",
        "func": "let data = msg.payload;\n\n// Nếu MQTT payload là string JSON\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        node.error(\"Invalid JSON payload\", msg);\n        return null;\n    }\n}\n\n// Kiểm tra device_id\nif (!data.device_id) {\n    node.error(\"Missing device_id\", msg);\n    return null;\n}\n\n// Chuẩn hóa dữ liệu\nmsg.payload = {\n    device_id: data.device_id,\n    temperature: data.temp,\n    ph: data.ph,\n    turbidity: data.tur,\n\n    // Giữ lại status từ ESP32\n    status: {\n        temp: data.status?.temp ?? \"missing\",\n        ph: data.status?.ph ?? \"missing\",\n        tur: data.status?.tur ?? \"missing\"\n    },\n    ai_status: data.ai_status ?? \"UNKNOWN\",\n    created_at: new Date()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 180,
        "wires": [
            [
                "989540dc2aabbe9e"
            ]
        ]
    },
    {
        "id": "989540dc2aabbe9e",
        "type": "function",
        "z": "d202adfd03874078",
        "name": "Insert Sensor Data",
        "func": "let data = msg.payload;\n\nnode.warn(\"PAYLOAD = \" + JSON.stringify(data));\nnode.warn(\"TEMP = \" + data?.temperature);\nnode.warn(\"PH = \" + data?.ph);\nnode.warn(\"TUR = \" + data?.turbidity);\nnode.warn(\"AI STATUS = \" + data?.ai_status);\n\nif (!data || !data.device_id) {\n    node.error(\"Missing device_id\", msg);\n    return null;\n}\n\nmsg.topic = `\nINSERT INTO sensor_data\n(\n    device_id,\n    temperature,\n    ph,\n    turbidity,\n    temp_status,\n    ph_status,\n    tur_status,\n    ai_status\n)\nVALUES\n(\n    '${data.device_id}',\n    ${data.temperature ?? 0},\n    ${data.ph ?? 0},\n    ${data.turbidity ?? 0},\n    '${data.status?.temp ?? \"missing\"}',\n    '${data.status?.ph ?? \"missing\"}',\n    '${data.status?.tur ?? \"missing\"}',\n    '${data.ai_status ?? \"UNKNOWN\"}'\n)\n`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 890,
        "y": 180,
        "wires": [
            [
                "427ee69418de6740"
            ]
        ]
    },
