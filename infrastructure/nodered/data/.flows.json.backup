        "wires": []
    },
    {
        "id": "377e2443951476e8",
        "type": "function",
        "z": "8d56405365d8f659",
        "name": "update machine name",
        "func": "const body = msg.payload;\n\nif (!body || typeof body !== \"object\") {\n  msg.statusCode = 400;\n  msg.payload = {\n    success: false,\n    message: \"Invalid JSON body\"\n  };\n  return msg;\n}\n\nconst device_id = body.device_id;\nconst machine_name = body.machine_name;\n\nif (!device_id || !machine_name) {\n  msg.statusCode = 400;\n  msg.payload = {\n    success: false,\n    message: \"device_id and machine_name are required\"\n  };\n  return msg;\n}\n\nif (!/^[0-9A-Fa-f]{12}$/.test(device_id)) {\n  msg.statusCode = 400;\n  msg.payload = {\n    success: false,\n    message: \"Invalid device_id\"\n  };\n  return msg;\n}\n\nif (typeof machine_name !== \"string\" ||\n  machine_name.length < 1 ||\n  machine_name.length > 50) {\n\n  msg.statusCode = 400;\n  msg.payload = {\n    success: false,\n    message: \"Invalid machine_name\"\n  };\n  return msg;\n}\n\nconst safeDeviceId = device_id.replace(/'/g, \"''\");\nconst safeMachineName = machine_name.replace(/'/g, \"''\");\n\nmsg.topic =\n  \"UPDATE devices \" +\n  \"SET machine_name = '\" + safeMachineName + \"' \" +\n  \"WHERE device_id = '\" + safeDeviceId + \"';\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 1180,
        "wires": [
            [
                "7692a8437a4b237a"
            ]
        ]
    },
