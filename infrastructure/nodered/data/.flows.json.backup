    {
        "id": "457579481dfd1339",
        "type": "function",
        "z": "c882ef36171e5406",
        "name": "Set Selected Device",
        "func": "let selectedId = msg.payload;\n\nif (!selectedId) {\n\n    node.warn(\"Không có device được chọn\");\n\n    return null;\n}\n\nlet devices = flow.get(\"deviceList\") || [];\n\nif (!Array.isArray(devices)) {\n\n    node.warn(\"deviceList không hợp lệ\");\n\n    return null;\n}\n\nlet device = devices.find(\n    d => d.device_id === selectedId\n);\n\nif (!device) {\n\n    node.warn(\n        \"Không tìm thấy device ID: \" + selectedId\n    );\n\n    return null;\n}\n\n// ===============================\n// LƯU DEVICE ID THẬT\n// ===============================\n\nflow.set(\n    \"selectedDevice\",\n    device.device_id\n);\n\n// ===============================\n// LƯU TÊN ĐỂ HIỂN THỊ\n// ===============================\n\nflow.set(\n    \"selectedDeviceName\",\n    device.machine_name\n);\n\nnode.warn(\n    \"SELECTED = \" +\n    device.machine_name +\n    \" | ID = \" +\n    device.device_id\n);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1140,
        "y": 80,
