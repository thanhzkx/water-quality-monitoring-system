    {
        "id": "70aedaf41635f783",
        "type": "function",
        "z": "c882ef36171e5406",
        "name": "Store Latest Sensor",
        "func": "if (!msg.payload || !msg.payload.device_id) {\n\n    node.warn(\"Missing device_id\");\n\n    return null;\n\n}\n\nconst deviceId = msg.payload.device_id;\n\nlet sensors = flow.get(\"latestSensors\") || {};\n\nsensors[deviceId] = {\n\n    temp: msg.payload.temp,\n\n    ph: msg.payload.ph,\n\n    tur: msg.payload.tur,\n\n    timestamp: msg.payload.timestamp,\n\n    status: msg.payload.status || {},\n\n    ai_status: msg.payload.ai_status || \"UNKNOWN\"\n\n};\n\nflow.set(\"latestSensors\", sensors);\n\nconst selected = flow.get(\"selectedDevice\");\n\nnode.warn(\n    \"MQTT ID = \" + deviceId +\n    \" | SELECTED ID = \" + selected\n);\n\n// Không phải device đang chọn → chỉ lưu\nif (!selected || deviceId !== selected) {\n\n    return null;\n\n}\n\nnode.warn(\n    \"SEND SENSOR | TEMP=\" + msg.payload.temp +\n    \" | PH=\" + msg.payload.ph +\n    \" | TUR=\" + msg.payload.tur +\n    \" | AI=\" + (msg.payload.ai_status || \"UNKNOWN\")\n);\n\n// Device đang chọn → gửi 4 giá trị\n\nreturn [\n\n    {\n        topic: \"Temperature\",\n        payload: msg.payload.temp\n    },\n\n    {\n        topic: \"pH\",\n        payload: msg.payload.ph\n    },\n\n    {\n        topic: \"Turbidity\",\n        payload: msg.payload.tur\n    },\n\n    {\n        topic: \"AI Status\",\n        payload: msg.payload.ai_status || \"UNKNOWN\"\n    }\n\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 220,
