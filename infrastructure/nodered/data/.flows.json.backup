    {
        "id": "3f0f3a0ce247ab01",
        "type": "ui_template",
        "z": "1c47f702e1aae6d5",
        "group": "0cbe89ca202dcbde",
        "name": "admin",
        "order": 1,
        "width": "30",
        "height": "10",
        "format": "<div class=\"admin-company\">\n\n    <h2>COMPANY MANAGEMENT</h2>\n\n    <div class=\"create-box\">\n\n        <input\n            id=\"companyName\"\n            type=\"text\"\n            placeholder=\"Company Name\"\n        >\n\n        <input\n            id=\"companyUsername\"\n            type=\"text\"\n            placeholder=\"Username\"\n        >\n\n        <input\n            id=\"companyPassword\"\n            type=\"password\"\n            placeholder=\"Password\"\n        >\n\n        <button onclick=\"createCompany()\">\n            CREATE COMPANY\n        </button>\n\n    </div>\n\n    <div id=\"companyMessage\"></div>\n\n    <table>\n\n        <thead>\n            <tr>\n                <th>ID</th>\n                <th>Company</th>\n                <th>Username</th>\n            </tr>\n        </thead>\n\n        <tbody id=\"companyTable\">\n        </tbody>\n\n    </table>\n\n</div>\n\n\n<style>\n    .admin-company {\n        width: 100%;\n        padding: 10px;\n        box-sizing: border-box;\n        font-family: Arial, sans-serif;\n    }\n\n    .admin-company h2 {\n        margin: 0 0 20px 0;\n        font-size: 22px;\n    }\n\n    .create-box {\n        display: flex;\n        gap: 10px;\n        margin-bottom: 20px;\n    }\n\n    .create-box input {\n        padding: 10px;\n        width: 200px;\n        box-sizing: border-box;\n    }\n\n    .create-box button {\n        padding: 10px 18px;\n        border: none;\n        cursor: pointer;\n    }\n\n    #companyMessage {\n        margin-bottom: 15px;\n    }\n\n    .admin-company table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n\n    .admin-company th,\n    .admin-company td {\n        text-align: left;\n        padding: 12px;\n        border-bottom: 1px solid #ddd;\n    }\n\n    .admin-company th {\n        font-weight: bold;\n    }\n</style>\n\n\n<script>\n    (function(scope) {\n\n    const API =\n        \"http://180.93.228.86:3000\";\n\n\n    function getToken() {\n\n        return sessionStorage.getItem(\n            \"water_token\"\n        );\n\n    }\n\n\n    window.createCompany = function() {\n\n        const companyName =\n            document.getElementById(\n                \"companyName\"\n            ).value.trim();\n\n        const username =\n            document.getElementById(\n                \"companyUsername\"\n            ).value.trim();\n\n        const password =\n            document.getElementById(\n                \"companyPassword\"\n            ).value;\n\n\n        if (\n            !companyName ||\n            !username ||\n            !password\n        ) {\n\n            alert(\n                \"Vui lòng nhập đầy đủ thông tin\"\n            );\n\n            return;\n\n        }\n\n\n        fetch(\n            API + \"/api/admin/companies\",\n            {\n                method: \"POST\",\n\n                headers: {\n                    \"Content-Type\":\n                        \"application/json\",\n\n                    \"Authorization\":\n                        \"Bearer \" +\n                        getToken()\n                },\n\n                body: JSON.stringify({\n\n                    company_name:\n                        companyName,\n\n                    username:\n                        username,\n\n                    password:\n                        password\n\n                })\n            }\n        )\n\n        .then(response =>\n            response.json()\n        )\n\n        .then(data => {\n\n            if (data.success) {\n\n                document.getElementById(\n                    \"companyName\"\n                ).value = \"\";\n\n                document.getElementById(\n                    \"companyUsername\"\n                ).value = \"\";\n\n                document.getElementById(\n                    \"companyPassword\"\n                ).value = \"\";\n\n                document.getElementById(\n                    \"companyMessage\"\n                ).innerText =\n                    \"Tạo công ty thành công\";\n\n                loadCompanies();\n\n            } else {\n\n                alert(\n                    data.message ||\n                    \"Tạo công ty thất bại\"\n                );\n\n            }\n\n        })\n\n        .catch(error => {\n\n            console.error(error);\n\n            alert(\n                \"Không kết nối được API\"\n            );\n\n        });\n\n    };\n\n\n    function loadCompanies() {\n\n        const token =\n            getToken();\n\n        if (!token) {\n            return;\n        }\n\n\n        fetch(\n            API + \"/api/admin/companies\",\n            {\n                method: \"GET\",\n\n                headers: {\n                    \"Authorization\":\n                        \"Bearer \" + token\n                }\n            }\n        )\n\n        .then(response =>\n            response.json()\n        )\n\n        .then(data => {\n\n            if (\n                !data.success ||\n                !Array.isArray(\n                    data.companies\n                )\n            ) {\n                return;\n            }\n\n\n            const table =\n                document.getElementById(\n                    \"companyTable\"\n                );\n\n            table.innerHTML = \"\";\n\n\n            data.companies.forEach(\n                company => {\n\n                    const row =\n                        document.createElement(\n                            \"tr\"\n                        );\n\n                    row.innerHTML = `\n\n                        <td>\n                            ${company.id}\n                        </td>\n\n                        <td>\n                            ${company.company_name}\n                        </td>\n\n                        <td>\n                            ${company.username || \"-\"}\n                        </td>\n\n                    `;\n\n                    table.appendChild(row);\n\n                }\n            );\n\n        })\n\n        .catch(error => {\n\n            console.error(\n                \"Load companies error:\",\n                error\n            );\n\n        });\n\n    }\n\n\n    loadCompanies();\n\n\n})(scope);\n\n</script>",
