    {
        "id": "f151247dcd02e937",
        "type": "function",
        "z": "669c09c766e36bb6",
        "name": "Insert Clean Data",
        "func": "let rows = msg.cleanData;\nlet sql = [];\n\nfunction formatMySQLDate(dateValue) {\n\n    let d = new Date(dateValue);\n\n    if (isNaN(d.getTime())) {\n        throw new Error(\n            \"Invalid created_at: \" +\n            dateValue\n        );\n    }\n\n    return d.getFullYear() + \"-\" +\n        String(d.getMonth() + 1).padStart(2, \"0\") + \"-\" +\n        String(d.getDate()).padStart(2, \"0\") + \" \" +\n        String(d.getHours()).padStart(2, \"0\") + \":\" +\n        String(d.getMinutes()).padStart(2, \"0\") + \":\" +\n        String(d.getSeconds()).padStart(2, \"0\");\n}\n\nfor (let row of rows) {\n\n    if (!row.device_id) {\n\n        node.warn(\n            \"Missing device_id at created_at: \" +\n            row.created_at\n        );\n\n        continue;\n    }\n\n    let createdAt =\n        formatMySQLDate(row.created_at);\n\n    sql.push(`\n    INSERT INTO sensor_data_clean\n    (\n        device_id,\n        temperature,\n        ph,\n        turbidity,\n        created_at,\n        temp_status,\n        ph_status,\n        tur_status\n    )\n    VALUES\n    (\n        '${row.device_id}',\n        ${row.temperature === null ? \"NULL\" : row.temperature},\n        ${row.ph === null ? \"NULL\" : row.ph},\n        ${row.turbidity === null ? \"NULL\" : row.turbidity},\n        '${createdAt}',\n        ${row.temp_status ? `'${row.temp_status}'` : \"NULL\"},\n        ${row.ph_status ? `'${row.ph_status}'` : \"NULL\"},\n        ${row.tur_status ? `'${row.tur_status}'` : \"NULL\"}\n    );\n    `);\n}\n\nmsg.topic = sql.join(\"\\n\");\n\nnode.warn(\n    \"Insert Clean Data: \" +\n    sql.length +\n    \" rows\"\n);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 970,
        "y": 540,
        "wires": [
            [
                "d3d2338f6d0d79ab",
                "23c295b9b6b70624"
            ]
        ]
