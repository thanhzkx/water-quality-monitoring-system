    {
        "id": "a58904ec97c62f61",
        "type": "function",
        "z": "8d56405365d8f659",
        "name": "GET DEVICE ID",
        "func": "if (!msg.payload || !msg.payload.device_id) {\n    node.warn(\"Missing device_id\");\n    return null;\n}\n\nmsg.device_id = msg.payload.device_id;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 940,
