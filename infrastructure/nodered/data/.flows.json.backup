    {
        "id": "9e0f6d1d62408353",
        "type": "function",
        "z": "8d56405365d8f659",
        "name": "Prepare Stats",
        "func": "let devices = msg.payload;\n\nif (!Array.isArray(devices)) {\n    node.error(\"Invalid devices data\", msg);\n    return null;\n}\n\nconst total = devices.length;\n\nconst online = devices.filter(\n    d => String(d.status || \"\").trim().toLowerCase() === \"online\"\n).length;\n\nconst offline = total - online;\n\nmsg.payload = {\n    total: total,\n    online: online,\n    offline: offline\n};\n\nreturn [\n    msg,\n    msg,\n    msg\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
        "y": 580,
