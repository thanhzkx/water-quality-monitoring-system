    {
        "id": "2d66a9ba9cf94d23",
        "type": "function",
        "z": "c882ef36171e5406",
        "name": "Show Selected Sensor",
        "func": "const selected = flow.get(\"selectedDevice\");\n\nif (!selected) {\n    node.warn(\"No device selected\");\n\n    return [\n        { payload: null },\n        { payload: null },\n        { payload: null },\n        { payload: null }\n    ];\n}\n\nconst sensors = flow.get(\"latestSensors\") || {};\n\nconst sensor = sensors[selected];\n\nnode.warn(\n    \"SHOW SELECTED = \" +\n    selected +\n    \" | DATA = \" +\n    JSON.stringify(sensor)\n);\n\n// Device chưa có dữ liệu\n\nif (!sensor) {\n\n    node.warn(\"Device chưa có sensor data\");\n\n    return [\n        { payload: null },\n        { payload: null },\n        { payload: null },\n        { payload: null }\n    ];\n}\n\n// Có dữ liệu\n\nreturn [\n    {\n        topic: \"Temperature\",\n        payload: sensor.temp\n    },\n\n    {\n        topic: \"pH\",\n        payload: sensor.ph\n    },\n\n    {\n        topic: \"Turbidity\",\n        payload: sensor.tur\n    },\n\n    {\n        topic: \"AI Status\",\n        payload: sensor.ai_status || \"UNKNOWN\"\n    }\n];",
