        "width": "30",
        "height": "6",
        "format": "<div class=\"device-status\">\n\n    <div class=\"section-title\">\n        DEVICE STATUS\n    </div>\n\n    <div class=\"table-wrapper\">\n\n        <table>\n\n            <thead>\n                <tr>\n                    <th>Device ID</th>\n                    <th>Machine Name</th>\n                    <th>Status</th>\n                    <th>Last Seen</th>\n                    <th>Action</th>\n                </tr>\n            </thead>\n\n            <tbody id=\"deviceStatusTable\">\n            </tbody>\n\n        </table>\n\n    </div>\n\n</div>\n\n\n<style>\n    .device-status {\n        width: 100%;\n        box-sizing: border-box;\n        font-family: Arial, sans-serif;\n    }\n\n    .section-title {\n        font-size: 18px;\n        font-weight: bold;\n        margin-bottom: 15px;\n    }\n\n    .table-wrapper {\n        width: 100%;\n        overflow-x: auto;\n    }\n\n    table {\n        width: 100%;\n        border-collapse: collapse;\n        font-size: 14px;\n    }\n\n    th {\n        text-align: left;\n        padding: 12px;\n        font-weight: bold;\n        border-bottom: 1px solid rgba(128, 128, 128, 0.35);\n    }\n\n    td {\n        padding: 10px 12px;\n        border-bottom: 1px solid rgba(128, 128, 128, 0.2);\n    }\n\n    .name-input {\n        width: 130px;\n        padding: 6px 8px;\n        border: 1px solid #ccc;\n        border-radius: 5px;\n        font-size: 14px;\n    }\n\n    .save-btn {\n        padding: 6px 12px;\n        border: none;\n        border-radius: 5px;\n        cursor: pointer;\n        font-size: 13px;\n    }\n\n    .status-online {\n        font-weight: bold;\n    }\n\n    .status-offline {\n        font-weight: bold;\n    }\n</style>\n\n\n<script>\n    (function(scope) {\n\n    // ==========================================\n    // NHẬN DỮ LIỆU TRỰC TIẾP TỪ MYSQL\n    // ==========================================\n\n    scope.$watch('msg', function(msg) {\n\n        if (!msg || !Array.isArray(msg.payload)) {\n            return;\n        }\n\n        const devices = msg.payload;\n\n        const table =\n            document.getElementById(\"deviceStatusTable\");\n\n        if (!table) {\n            return;\n        }\n\n        table.innerHTML = \"\";\n\n        devices.forEach(function(device) {\n\n            const row =\n                document.createElement(\"tr\");\n\n            const machine =\n                device.machine_name || \"\";\n\n            const isOnline =\n                String(device.status || \"\")\n                    .trim()\n                    .toLowerCase() === \"online\";\n\n            const statusText =\n                isOnline\n                    ? \"🟢 ONLINE\"\n                    : \"🔴 OFFLINE\";\n\n            const statusClass =\n                isOnline\n                    ? \"status-online\"\n                    : \"status-offline\";\n\n\n            row.innerHTML = `\n\n                <td>\n                    ${device.device_id}\n                </td>\n\n                <td>\n                    <input\n                        class=\"name-input\"\n                        id=\"name-${device.device_id}\"\n                        value=\"${machine}\"\n                        placeholder=\"Machine name\"\n                    >\n                </td>\n\n                <td class=\"${statusClass}\">\n                    ${statusText}\n                </td>\n\n                <td>\n                    ${device.last_seen || \"-\"}\n                </td>\n\n                <td>\n                    <button\n                        class=\"save-btn\"\n                        onclick=\"saveMachineName('${device.device_id}')\">\n                        Save\n                    </button>\n                </td>\n\n            `;\n\n            table.appendChild(row);\n\n        });\n\n    });\n\n\n    // ==========================================\n    // SAVE MACHINE NAME\n    // GIỮ NGUYÊN GỌI API\n    // ==========================================\n\n    window.saveMachineName = function(deviceId) {\n\n        const input =\n            document.getElementById(\n                \"name-\" + deviceId\n            );\n\n        if (!input) {\n            return;\n        }\n\n        const machineName =\n            input.value.trim();\n\n        if (!machineName) {\n\n            alert(\n                \"Machine name cannot be empty\"\n            );\n\n            return;\n        }\n\n\n        fetch(\n            \"http://180.93.228.86:3000/api/devices/name\",\n            {\n                method: \"POST\",\n\n                headers: {\n                    \"Content-Type\":\n                        \"application/json\",\n\n                    \"Authorization\":\n                        \"Bearer \" +\n                        sessionStorage.getItem(\n                            \"water_token\"\n                        )\n                },\n\n                body: JSON.stringify({\n\n                    device_id:\n                        deviceId,\n\n                    machine_name:\n                        machineName\n\n                })\n            }\n        )\n\n        .then(response =>\n            response.json()\n        )\n\n        .then(result => {\n\n            if (result.success) {\n\n                alert(\n                    \"Machine name updated successfully\"\n                );\n\n            } else {\n\n                alert(\n                    result.message ||\n                    \"Update failed\"\n                );\n\n            }\n\n        })\n\n        .catch(error => {\n\n            console.error(error);\n\n            alert(\n                \"Cannot connect to server\"\n            );\n\n        });\n\n    };\n\n})(scope);\n</script>",
