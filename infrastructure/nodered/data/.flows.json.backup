    },
    {
        "id": "6f9d41673adb11c8",
        "type": "function",
        "z": "8d56405365d8f659",
        "name": "Register / Update Device",
        "func": "if (!msg.device_id) {\n    node.warn(\"Missing device_id\");\n    return null;\n}\n\n// Device ID được tạo từ MAC nên chỉ cho phép HEX\nif (!/^[0-9A-Fa-f]{12}$/.test(msg.device_id)) {\n    node.warn(\"Invalid device_id: \" + msg.device_id);\n    return null;\n}\n\nmsg.topic = `\nINSERT INTO devices\n(device_id, machine_name, status, last_seen)\nVALUES\n(\n    '${msg.device_id}',\n    CONCAT(\n        'machine',\n        LPAD(\n            (\n                SELECT COALESCE(MAX(num), 0) + 1\n                FROM (\n                    SELECT CAST(SUBSTRING(machine_name, 8) AS UNSIGNED) AS num\n                    FROM devices\n                    WHERE machine_name REGEXP '^machine[0-9]+$'\n                ) AS t\n            ),\n            2,\n            '0'\n        )\n    ),\n    'online',\n    NOW()\n)\nON DUPLICATE KEY UPDATE\nstatus = 'online',\nlast_seen = NOW()\n`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 770,
        "y": 940,
        "wires": [
            [
                "7b63caeb04cc5022"
            ]
        ]
    },
