    {
        "id": "95c9ae8034629ef8",
        "type": "ui_template",
        "z": "294be529a92a6361",
        "group": "ed71895b6885dd71",
        "name": "",
        "order": 2,
        "width": "30",
        "height": "3",
        "format": "<div id=\"wifi-box\">\n\n    <div style=\"font-size:20px;font-weight:bold;margin-bottom:15px;\">\n        WiFi khả dụng\n    </div>\n\n    <div id=\"wifi-items\">\n        Đang chờ dữ liệu WiFi...\n    </div>\n\n    <div id=\"wifi-password\" style=\"display:none;margin-top:20px;\">\n\n        <div id=\"selected-wifi\" style=\"font-weight:bold;margin-bottom:10px;\">\n        </div>\n\n        <input id=\"wifi-pass\"\n               type=\"password\"\n               placeholder=\"Nhập mật khẩu WiFi\"\n               style=\"\n                   width:100%;\n                   padding:10px;\n                   box-sizing:border-box;\n                   margin-bottom:10px;\n               \">\n\n        <button id=\"wifi-connect\"\n                style=\"\n                    padding:10px 20px;\n                    cursor:pointer;\n                \">\n            Kết nối\n        </button>\n\n    </div>\n\n</div>\n\n<script>\n    (function(scope) {\n\n    scope.$watch('msg', function(msg) {\n\n        if (!msg || !msg.payload) return;\n\n        let data = msg.payload;\n\n        if (typeof data === \"string\") {\n            try {\n                data = JSON.parse(data);\n            } catch(e) {\n                return;\n            }\n        }\n\n        if (!data || !Array.isArray(data.networks)) return;\n\n        const container =\n            document.getElementById(\"wifi-items\");\n\n        if (!container) return;\n\n        container.innerHTML = \"\";\n\n        data.networks.forEach(function(wifi) {\n\n            const item =\n                document.createElement(\"div\");\n\n            item.style.padding = \"12px\";\n            item.style.marginBottom = \"8px\";\n            item.style.border = \"1px solid #ccc\";\n            item.style.borderRadius = \"8px\";\n            item.style.cursor = \"pointer\";\n\n            item.innerHTML =\n                \"<b>\" + wifi.ssid + \"</b>\" +\n                \" — \" + wifi.rssi + \" dBm\";\n\n            item.onclick = function() {\n\n                document.getElementById(\n                    \"wifi-password\"\n                ).style.display = \"block\";\n\n                document.getElementById(\n                    \"selected-wifi\"\n                ).innerText =\n                    \"WiFi đã chọn: \" + wifi.ssid;\n\n                document.getElementById(\n                    \"wifi-pass\"\n                ).value = \"\";\n\n                window.selectedWifiSSID =\n                    wifi.ssid;\n            };\n\n            container.appendChild(item);\n        });\n\n    });\n\n    document.addEventListener(\n        \"click\",\n        function(e) {\n\n            if (e.target.id !== \"wifi-connect\")\n                return;\n\n            const ssid =\n                window.selectedWifiSSID;\n\n            const password =\n                document.getElementById(\n                    \"wifi-pass\"\n                ).value;\n\n            if (!ssid) {\n                alert(\"Chưa chọn WiFi\");\n                return;\n            }\n\n            if (!password) {\n                alert(\"Chưa nhập mật khẩu\");\n                return;\n            }\n\n            scope.send({\n                topic: \"wifi/config\",\n                payload: {\n                    ssid: ssid,\n                    password: password\n                }\n            });\n\n        }\n    );\n\n})(scope);\n</script>",
