    {
        "id": "67de8e11705e526f",
        "type": "function",
        "z": "669c09c766e36bb6",
        "name": "Read Raw Data",
        "func": "let startDate = \"2026-07-28 00:00:00\";\n\nmsg.topic = `\nSELECT *\nFROM sensor_data\nWHERE created_at >= '${startDate}'\nORDER BY created_at;\n`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
