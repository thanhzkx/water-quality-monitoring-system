        "format": "<div class=\"sensor-card ai-card\">\n\n    <div class=\"sensor-header\">\n        <div class=\"sensor-icon\">🤖</div>\n\n        <div>\n            <div class=\"sensor-title\">AI ANOMALY DETECTION</div>\n            <div class=\"sensor-subtitle\">Water quality analysis</div>\n        </div>\n    </div>\n\n    <div class=\"sensor-value ai-value\">\n        {{msg.payload}}\n    </div>\n\n</div>\n\n<style>\n    .sensor-card {\n        height: 155px;\n        padding: 20px;\n        box-sizing: border-box;\n        border-radius: 18px;\n        background: #f4faff;\n        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);\n    }\n\n    .sensor-header {\n        height: 48px;\n        display: flex;\n        align-items: center;\n        gap: 12px;\n    }\n\n    .sensor-icon {\n        width: 32px;\n        text-align: center;\n        font-size: 25px;\n    }\n\n    .sensor-title {\n        font-size: 15px;\n        font-weight: 700;\n    }\n\n    .sensor-subtitle {\n        margin-top: 4px;\n        font-size: 11px;\n        color: #888;\n    }\n\n    .sensor-value {\n        margin-top: 20px;\n        font-size: 34px;\n        font-weight: 700;\n    }\n\n    .ai-value {\n        font-size: 30px;\n        letter-spacing: 0.5px;\n    }\n</style>",
