    {
        "id": "f88b4991ab7296aa",
        "type": "function",
        "z": "c882ef36171e5406",
        "name": "Prepare Device Options",
        "func": "let devices = msg.payload;\n\n// MySQL trả thẳng array\nif (!Array.isArray(devices)) {\n    node.error(\"MySQL không trả về danh sách devices\", msg);\n    return null;\n}\n\n// Lưu danh sách device\nflow.set(\"deviceList\", devices);\n\n// ===============================\n// AUTO SELECT DEVICE\n// ===============================\n\nlet selectedId = flow.get(\"selectedDevice\");\n\nlet selected = devices.find(\n    d => d.device_id === selectedId\n);\n\n// Nếu chưa có device → chọn device đầu tiên\nif (!selected && devices.length > 0) {\n\n    selected = devices[0];\n\n    flow.set(\n        \"selectedDevice\",\n        selected.device_id\n    );\n\n    flow.set(\n        \"selectedDeviceName\",\n        selected.machine_name || selected.device_id\n    );\n}\n\n// ===============================\n// DROPDOWN OPTIONS\n// ===============================\n\n// GIỮ ĐÚNG KIỂU CŨ\n// machine01 → device_id\n\nmsg.options = devices.map(d => ({\n    [d.machine_name || d.device_id]: d.device_id\n}));\n\n// Giá trị đang chọn\nmsg.payload = selected\n    ? selected.device_id\n    : null;\n\nreturn msg;",
